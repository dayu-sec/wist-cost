{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wist.harvest.cost.manifest.v1",
  "title": "harvest 成本范围清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "range",
    "currency",
    "period_source",
    "fetched_at",
    "shards",
    "total_rows"
  ],
  "properties": {
    "schema": { "const": "wist.harvest.cost.manifest.v1" },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "一次采集运行的唯一标识；重试沿用，新一轮必须换新"
    },
    "range": { "$ref": "#/$defs/range" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "period_source": {
      "type": "string",
      "enum": ["cloud_api", "legacy_import"]
    },
    "fetched_at": {
      "type": "string",
      "description": "带时区的 RFC3339 时间，如 2026-11-12T00:31:22+08:00"
    },
    "request_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "云 API RequestId，排障用；不含凭据"
    },
    "shards": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/shard" }
    },
    "total_rows": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "source_code",
        "vendor",
        "billing_account_uin",
        "cost_basis",
        "period_start",
        "period_end"
      ],
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "source_code": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "enum": ["TENCENT_CLOUD"] },
        "billing_account_uin": { "type": "string", "minLength": 1 },
        "cost_basis": { "type": "string", "enum": ["CONSUMPTION", "CHARGE"] },
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rows", "sha256", "bytes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "description": "四位序号，从 0001 起；拼进对象键"
        },
        "rows": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "分片文件字节的 sha256，小写十六进制"
        },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
