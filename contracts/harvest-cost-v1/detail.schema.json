{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wist.harvest.cost.detail.v1",
  "title": "harvest 成本明细行",
  "description": "NDJSON 分片的一行。标准化字段供入库与查询，raw 供追溯；两者必须来自同一次云响应。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cost_date",
    "bill_month",
    "business_code",
    "resource_key",
    "currency",
    "real_cost",
    "raw"
  ],
  "properties": {
    "schema": { "const": "wist.harvest.cost.detail.v1" },

    "cost_date": {
      "type": "string",
      "format": "date",
      "description": "CONSUMPTION 取查询日；CHARGE 取账单归属日（云侧 BillDay）。不能用付款时刻 PayTime：月底结算会跨零点，按付款时刻归日会把 10 月账单推到 11 月"
    },
    "bill_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },

    "business_code": { "type": "string", "minLength": 1 },
    "business_code_name": { "type": ["string", "null"] },
    "product_code": { "type": ["string", "null"] },
    "product_code_name": { "type": ["string", "null"] },

    "resource_id": { "type": ["string", "null"] },
    "resource_key": {
      "type": "string",
      "description": "business_code + ':' + resource_id；resource_id 缺失时为 business_code + ':UNALLOCATED'"
    },
    "resource_name": { "type": ["string", "null"] },

    "payer_uin": { "type": ["string", "null"] },
    "owner_uin": { "type": ["string", "null"] },
    "pay_mode_name": { "type": ["string", "null"] },
    "action_type_name": { "type": ["string", "null"] },

    "pay_time": { "type": ["string", "null"] },
    "fee_begin_time": { "type": ["string", "null"] },
    "fee_end_time": { "type": ["string", "null"] },

    "provider_detail_id": { "type": ["string", "null"] },
    "bill_id": { "type": ["string", "null"] },
    "order_id": { "type": ["string", "null"] },

    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },

    "real_cost": { "$ref": "#/$defs/money" },
    "cash_amount": { "$ref": "#/$defs/money" },
    "voucher_amount": { "$ref": "#/$defs/money" },
    "incentive_amount": { "$ref": "#/$defs/money" },
    "transfer_amount": { "$ref": "#/$defs/money" },

    "components": {
      "type": "array",
      "description": "组件原文，不丢字段；real_cost 为各组件求和（在 cost 侧计算，不在此重复）",
      "items": { "type": "object" }
    },

    "raw": {
      "type": "object",
      "description": "云返回的完整明细对象，不含请求凭据；追溯与补字段用"
    }
  },
  "$defs": {
    "money": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "十进制字符串，18 位小数以内。null = 未知，'0' = 确认为零，退款为负"
    }
  }
}
